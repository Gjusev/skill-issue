{
  "name": "skill-issue-tool",
  "version": "1.0.0",
  "description": "Local harness that runs the same task with and without a skill, and shows the evidence: activation, verification, time and available metrics.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gjusev/skill-issue.git"
  },
  "bugs": {
    "url": "https://github.com/Gjusev/skill-issue/issues"
  },
  "homepage": "https://github.com/Gjusev/skill-issue#readme",
  "files": [
    "bin",
    "src",
    "skills",
    "examples",
    "fixtures",
    "tests",
    "tsconfig.json"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "skill-issue": "bin/skill-issue.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "test:cli": "node tests/e2e/cli.e2e.ts",
    "test:e2e": "node tests/e2e/viewer.e2e.ts",
    "viewer": "node src/cli.ts viewer"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "puppeteer-core": "^24.30.0",
    "typescript": "^5.9.3"
  }
}
